{
  "name": "aiquila-mcp",
  "version": "0.5.4",
  "description": "Nextcloud MCP server — 384 tools: files, calendar, contacts, mail, Talk, Deck, photos, maps, notes",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aiquila-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/sync-server-json.mjs && (tsc --noCheck || tsc)",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p .",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "inspect:cli": "npx @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "nextcloud",
    "claude",
    "mistral",
    "deepseek",
    "ollama",
    "llm",
    "ai",
    "aiquila",
    "coworker",
    "talk",
    "mail",
    "nextcloud-mcp",
    "webdav",
    "caldav",
    "carddav",
    "self-hosted"
  ],
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "author": "sirgorro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elgorro/aiquila.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/elgorro"
    },
    {
      "type": "liberapay",
      "url": "https://liberapay.com/elgorro/donate"
    }
  ],
  "mcpName": "io.github.elgorro/aiquila-mcp",
  "files": [
    "dist/"
  ],
  "overrides": {
    "@hono/node-server": "^2.1.8",
    "brace-expansion": "^2.1.7",
    "esbuild": ">=0.28.1",
    "hono": "^4.13.16",
    "minimatch": {
      ".": "^11.0.1",
      "brace-expansion": "^5.0.12"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jose": "^6.2.15",
    "pino": "^10.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.1.0"
  }
}
