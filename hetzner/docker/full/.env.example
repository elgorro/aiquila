# AIquila Full Stack — Hetzner Production (Nextcloud + MCP on one server)
# Copy this file to .env and fill in all required values.
# This file is safe to commit (no real secrets).

# ── Nextcloud domain ──────────────────────────────────────────────────────────
NC_DOMAIN=nc.example.com

# ── MCP domain ────────────────────────────────────────────────────────────────
MCP_DOMAIN=mcp.example.com

# Internal port the MCP container listens on (Traefik routes to this port)
MCP_PORT=3339

# Required: email for Let's Encrypt expiry notices (empty string causes LE to reject)
ACME_EMAIL=you@example.com

# ── Nextcloud admin account ────────────────────────────────────────────────────
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=replace-with-strong-password

# ── Nextcloud user for MCP_INTERNAL_TOKEN (deprecated) ────────────────────────
# Only the Nextcloud app's internal calls use it; OAuth sign-ins act as the
# signed-in user.
NC_MCP_USER=admin
NC_MCP_PASSWORD=replace-with-app-password

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-hex-32

# ── OAuth 2.0 (required for HTTP-based MCP clients) ──────────────────────────
MCP_AUTH_ENABLED=true

# Random 64-char hex secret — generate with: openssl rand -hex 32
MCP_AUTH_SECRET=replace-with-openssl-rand-hex-32

# Encrypts the Nextcloud app passwords of signed-in users at rest.
# 512-bit — generate with: openssl rand -hex 64
MCP_CREDENTIAL_KEY=replace-with-openssl-rand-hex-64

# Public HTTPS URL of the MCP server (same as https://$MCP_DOMAIN)
MCP_AUTH_ISSUER=https://mcp.example.com

# ── OAuth client configuration ────────────────────────────────────────────────
# Option A — Dynamic registration (recommended): enable below so any MCP client
# can self-register. Gate access with MCP_REGISTRATION_TOKEN if desired.
#
# Option B — Static pre-seeded client: set MCP_CLIENT_ID + MCP_CLIENT_REDIRECT_URIS
# for clients that do not support dynamic registration.
# Example redirect URIs:
#   Claude.ai / Claude Code:  https://claude.ai/api/mcp/auth_callback
#   Other clients: check your MCP client's documentation for its callback URL
MCP_CLIENT_ID=
# Deprecated: MCP_CLIENT_SECRET is no longer used — public PKCE clients do not
# send a client_secret. Keep empty unless you have older deployments that require it.
MCP_CLIENT_SECRET=

# Comma-separated redirect URIs for the pre-seeded client (Option B only).
# Leave empty when using dynamic registration (Option A).
MCP_CLIENT_REDIRECT_URIS=

# ── Dynamic client registration ───────────────────────────────────────────────
# Recommended: set to true so any MCP client can self-register automatically.
MCP_REGISTRATION_ENABLED=false
MCP_REGISTRATION_TOKEN=

# Client ID Metadata Documents — clients whose client_id is an HTTPS URL serving
# their metadata need no registration. Empty = on, or off when
# MCP_REGISTRATION_TOKEN is set (a gated server has chosen its clients).
# true / false overrides. See docs/mcp/oauth.md.
MCP_CIMD_ENABLED=

# Redirect URIs a dynamically registered client may use, beyond the defaults
# (loopback, claude.ai, claude.com, the NEXTCLOUD_URL host, and private-use
# schemes with a dot). Comma-separated hosts, `scheme:` entries, or `*` for any
# https host. See docs/mcp/oauth.md.
# Empty = the Nextcloud domain (NC_DOMAIN), since NEXTCLOUD_URL is internal here.
MCP_REDIRECT_ALLOWLIST=

# OAuth state persistence — directory for clients.json + refresh-tokens.json
# Mount a Docker volume here (done automatically in docker-compose.yml).
# MCP_AUTH_STATE_DIR=/app/state

# ── Internal networking ──────────────────────────────────────────────────
# Extra hostnames accepted by the MCP SDK's DNS rebinding protection.
# Comma-separated. Required when Nextcloud connects to MCP via Docker service name.
MCP_ALLOWED_HOSTS=mcp

# Extra browser origins allowed via CORS (comma-separated).
# The MCP_AUTH_ISSUER origin is always allowed.
MCP_CORS_ORIGINS=

# Pre-shared bearer token for service-to-service auth — generate with: openssl rand -hex 32
# Bypasses OAuth. Accepted only on direct connections from internal addresses
# (Docker network), never through Traefik. See docs/mcp/oauth.md#security-notes.
MCP_INTERNAL_TOKEN=

# ── CrowdSec ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=replace-with-random-hex-32

# ── Metrics ───────────────────────────────────────────────────────────────
# Token for the built-in built-in metrics app endpoint: https://<NC_DOMAIN>/metrics?token=<value>
# Leave empty to disable, or generate with: openssl rand -hex 16
NC_METRICS_TOKEN=

# ── TLS certificate check ──────────────────────────────────────────────────────
# Hard-fail on startup if MCP_AUTH_ISSUER has a self-signed or expired cert.
# Default is false (log warning but continue) — keeps working during Let's Encrypt init.
# Set to true once the cert is valid and stable.
MCP_TLS_STRICT=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
