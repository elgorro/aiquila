{
    "name": "aiquila/aiquila",
    "description": "AIquila - Claude AI Integration for Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "anthropic-ai/sdk": "^1.3",
        "psr/log": "*",
        "symfony/http-client": "^8.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "nextcloud/openapi-extractor": "^1.8",
        "nextcloud/ocp": "^35.0",
        "doctrine/dbal": "^4.4",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\AIquila\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\AIquila\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "psalm": "psalm --no-cache",
        "openapi": [
            "generate-spec --openapi-version 3.1.0",
            "@php tools/openapi-3.1.php openapi.json openapi-administration.json openapi-full.json"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
